															<object type="Action" id="18">
															    <base type="Interaction">
																<base type="Entity">
																    <field name="name">RetornarDiners</field>
																    <field name="description">Acció que es duu a terme un cop la devolució ha sigut acceptada. Es retornen els diners dels productes a retornar. </field>
																    <field name="uniqueId">89</field>
																    <field name="connectTo"><list>
																	<object type="Actor" id="19">
																	    <base type="Entity">
																		<field name="name">Servei pagament</field>
																		<field name="description">És el servei que s'encarrega de gestionar pagaments. Aquest es el servei al que encarregarem el cobrament dels productes que comprin els clients així com la devolució dels diner cuan escaigui. En resúm serà el servei encarregat de realitzar les transaccións monetàries.</field>
																		<field name="uniqueId">211</field>
																		<field name="connectTo"><list>
																		    <object type="Percept" id="20">
																			<base type="Interaction">
																			    <base type="Entity">
																				<field name="name">Confirmació cobrament</field>
																				<field name="description">Percepció provinent de la plataforma de pagament que ens avisa que s'ha efectuat el cobrament amb èxit.</field>
																				<field name="uniqueId">266</field>
																				<field name="connectTo"><list>
																				    <object type="Actor" id="21">
																					<base type="Entity">
																					    <field name="name">Sistema central</field>
																					    <field name="description">Es el nostre propi sistema, encarregat de donar resposta a totes les peticions demanades pels clients així com coordinarse amb tots els actors externs per a la resolució de les tasques i serveis que oferiex el sistema.</field>
																					    <field name="uniqueId">209</field>
																					    <field name="connectTo"><list>
																						<object type="Action" id="22">
																						    <base type="Interaction">
																							<base type="Entity">
																							    <field name="name">EnviarFactura</field>
																							    <field name="description">S'envia la factura dels productes comprats a l'usuari.</field>
																							    <field name="uniqueId">101</field>
																							    <field name="connectTo"><list>
																								<object type="Actor" id="23">
																								    <base type="Entity">
																									<field name="name">Client</field>
																									<field name="description">El client es el actor que representa els usuaris. És el més importatnt ja que es el qui ens iniciarà totes les diferents accións que proporciona el nostre sistema i el receptor de totes aquestes en ultima instància.</field>
																									<field name="uniqueId">206</field>
																									<field name="connectTo"><list>
																									    <object type="Percept" id="24">
																										<base type="Interaction">
																										    <base type="Entity">
																											<field name="name">Petició de devolució</field>
																											<field name="description">Percepció que ve donada quan un usuari vol retornar algun dels productes que prèviament ha comprat.</field>
																											<field name="uniqueId">90</field>

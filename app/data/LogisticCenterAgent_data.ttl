@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix practicaecsdi: <http://www.semanticweb.org/hp/ontologies/2024/4/PracticaECSDI#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/product/Laptop> a practicaecsdi:Product ;
    practicaecsdi:Producte_nom "Laptop"^^xsd:string ;
    practicaecsdi:Producte_preu "10"^^xsd:float ;
    practicaecsdi:Quantitat_stock 10 .

<http://example.org/product/Laptop2> a practicaecsdi:Product ;
    practicaecsdi:Producte_nom "Laptop2"^^xsd:string ;
    practicaecsdi:Producte_preu "10"^^xsd:float ;
    practicaecsdi:Quantitat_stock 10 .

<http://www.semanticweb.org/hp/ontologies/2024/4/PracticaECSDI> a owl:Ontology .

practicaecsdi:Ciutat_entrega a owl:ObjectProperty ;
    rdfs:domain practicaecsdi:DemanarOfertaTransport ;
    rdfs:range practicaecsdi:Ciutat ;
    rdfs:subPropertyOf owl:topObjectProperty .

practicaecsdi:Constituida_per a owl:ObjectProperty ;
    rdfs:domain practicaecsdi:Valoracio ;
    rdfs:range practicaecsdi:Producte ;
    rdfs:subPropertyOf owl:topObjectProperty .

practicaecsdi:Constituida_per2 a owl:ObjectProperty ;
    rdfs:domain practicaecsdi:Valoracio ;
    rdfs:range practicaecsdi:Usuari ;
    rdfs:subPropertyOf owl:topObjectProperty .

practicaecsdi:Constituit_per a owl:ObjectProperty ;
    rdfs:comment "Un lot de productes esta constituit per diferents productes" ;
    rdfs:domain practicaecsdi:LotProductes ;
    rdfs:range practicaecsdi:CompraUsuari ;
    rdfs:subPropertyOf owl:topObjectProperty .

practicaecsdi:Conte a owl:ObjectProperty ;
    rdfs:domain practicaecsdi:Recomanacio ;
    rdfs:range practicaecsdi:Producte ;
    rdfs:subPropertyOf owl:topObjectProperty .

practicaecsdi:De a owl:ObjectProperty ;
    rdfs:comment "Enviament d'un lot de productes" ;
    rdfs:domain practicaecsdi:EnviarLots ;
    rdfs:range practicaecsdi:LotProductes ;
    rdfs:subPropertyOf owl:topObjectProperty .

practicaecsdi:Demana a owl:ObjectProperty ;
    rdfs:comment "El usuari demana Buscar un o més producte (ja sigui filtrant-lo o demanant un producte en especific)" ;
    rdfs:domain practicaecsdi:BuscarProducte ;
    rdfs:range practicaecsdi:Producte ;
    rdfs:subPropertyOf owl:topObjectProperty .

practicaecsdi:Disposa2_de a owl:ObjectProperty ;
    rdfs:domain practicaecsdi:CentreLogistic ;
    rdfs:range practicaecsdi:Stock ;
    rdfs:subPropertyOf owl:topObjectProperty .

practicaecsdi:Disposa_de a owl:ObjectProperty ;
    rdfs:comment "Un centre logistic disposa de stock" ;
    rdfs:domain practicaecsdi:Producte ;
    rdfs:range practicaecsdi:Stock ;
    rdfs:subPropertyOf owl:topObjectProperty .

practicaecsdi:Es_demana_a a owl:ObjectProperty ;
    rdfs:comment "Es demana disponibilitat de stock al centre logistic" ;
    rdfs:domain practicaecsdi:DemanarDisponibilitat ;
    rdfs:range practicaecsdi:CentreLogistic ;
    rdfs:subPropertyOf owl:topObjectProperty .

practicaecsdi:Es_dirigida2_a a owl:ObjectProperty ;
    rdfs:domain practicaecsdi:TriarTransportista ;
    rdfs:range practicaecsdi:EmpresaTransport ;
    rdfs:subPropertyOf owl:topObjectProperty .

practicaecsdi:Es_dirigida_a a owl:ObjectProperty ;
    rdfs:domain practicaecsdi:DemanarOfertaTransport ;
    rdfs:range practicaecsdi:EmpresaTransport ;
    rdfs:subPropertyOf owl:topObjectProperty .

practicaecsdi:Es_propietat_de a owl:ObjectProperty ;
    rdfs:domain practicaecsdi:ProducteExtern ;
    rdfs:range practicaecsdi:VenedorExtern ;
    rdfs:subPropertyOf owl:topObjectProperty .

practicaecsdi:FiltrarProducte a owl:Class ;
    rdfs:subClassOf practicaecsdi:BuscarProducte ;
    owl:disjointWith practicaecsdi:MostrarProducte .

practicaecsdi:Formada2_de a owl:ObjectProperty ;
    rdfs:domain practicaecsdi:CompraUsuari ;
    rdfs:range practicaecsdi:Usuari ;
    rdfs:subPropertyOf owl:topObjectProperty .

practicaecsdi:Formada_de a owl:ObjectProperty ;
    rdfs:comment "Una compra esta formada per diferents productes" ;
    rdfs:domain practicaecsdi:CompraUsuari ;
    rdfs:range practicaecsdi:Compra ;
    rdfs:subPropertyOf owl:topObjectProperty .

practicaecsdi:Formada_per a owl:ObjectProperty ;
    rdfs:comment "Empresa de transport formada per diferents transportistes" ;
    rdfs:domain practicaecsdi:EmpresaTransport ;
    rdfs:range practicaecsdi:Transportista ;
    rdfs:subPropertyOf owl:topObjectProperty .

practicaecsdi:Format2_per a owl:ObjectProperty ;
    rdfs:domain practicaecsdi:CercaUsuari ;
    rdfs:range practicaecsdi:Usuari ;
    rdfs:subPropertyOf owl:topObjectProperty .

practicaecsdi:Format_per a owl:ObjectProperty ;
    rdfs:domain practicaecsdi:CercaUsuari ;
    rdfs:range practicaecsdi:Producte ;
    rdfs:subPropertyOf owl:topObjectProperty .

practicaecsdi:Necessita a owl:ObjectProperty ;
    rdfs:comment "Una oferta de transport necessita un transportista" ;
    rdfs:domain practicaecsdi:OfertaTransport ;
    rdfs:range practicaecsdi:Transportista ;
    rdfs:subPropertyOf owl:topObjectProperty .

practicaecsdi:Ofereix a owl:ObjectProperty ;
    rdfs:comment "Una empresa de transport ofereix diferents ofertes" ;
    rdfs:domain practicaecsdi:EmpresaTransport ;
    rdfs:range practicaecsdi:OfertaTransport ;
    rdfs:subPropertyOf owl:topObjectProperty .

practicaecsdi:Registra_a a owl:ObjectProperty ;
    rdfs:domain practicaecsdi:RegistrarProducteExtern ;
    rdfs:range practicaecsdi:ProducteExtern ;
    rdfs:subPropertyOf owl:topObjectProperty .

practicaecsdi:Retorna a owl:ObjectProperty ;
    rdfs:domain practicaecsdi:PeticioDevolucio ;
    rdfs:range practicaecsdi:Compra ;
    rdfs:subPropertyOf owl:topObjectProperty .

practicaecsdi:Retorna2 a owl:ObjectProperty ;
    rdfs:domain practicaecsdi:IniciarCompra ;
    rdfs:range practicaecsdi:Compra ;
    rdfs:subPropertyOf owl:topObjectProperty .

practicaecsdi:Sentrega_a a owl:ObjectProperty ;
    rdfs:domain practicaecsdi:CompraUsuari ;
    rdfs:range practicaecsdi:Direcció ;
    rdfs:subPropertyOf owl:topObjectProperty .

practicaecsdi:Senvia_a a owl:ObjectProperty ;
    rdfs:domain practicaecsdi:Recomanacio ;
    rdfs:range practicaecsdi:Usuari ;
    rdfs:subPropertyOf owl:topObjectProperty .

practicaecsdi:Te a owl:ObjectProperty ;
    rdfs:domain practicaecsdi:Compra ;
    rdfs:range practicaecsdi:Producte ;
    rdfs:subPropertyOf owl:topObjectProperty .

practicaecsdi:Te_desti_en a owl:ObjectProperty ;
    rdfs:comment "Un lot de productes (que esta format per productes comprats) tots sentreguen a la mateixa ciutat" ;
    rdfs:domain practicaecsdi:LotProductes ;
    rdfs:range practicaecsdi:Ciutat ;
    rdfs:subPropertyOf owl:topObjectProperty .

practicaecsdi:Te_origen_en a owl:ObjectProperty ;
    rdfs:domain practicaecsdi:LotProductes ;
    rdfs:range practicaecsdi:CentreLogistic ;
    rdfs:subPropertyOf owl:topObjectProperty .

practicaecsdi:Transporta a owl:ObjectProperty ;
    rdfs:domain practicaecsdi:Transportista ;
    rdfs:range practicaecsdi:EnviarLots ;
    rdfs:subPropertyOf owl:topObjectProperty .

practicaecsdi:Ubicat2_en a owl:ObjectProperty ;
    rdfs:domain practicaecsdi:CentreLogistic ;
    rdfs:range practicaecsdi:Ciutat ;
    rdfs:subPropertyOf owl:topObjectProperty .

practicaecsdi:Ubicat3_en a owl:ObjectProperty ;
    rdfs:domain practicaecsdi:EmpresaTransport ;
    rdfs:range practicaecsdi:Direcció ;
    rdfs:subPropertyOf owl:topObjectProperty .

practicaecsdi:Ubicat4_en a owl:ObjectProperty ;
    rdfs:domain practicaecsdi:EmpresaTransport ;
    rdfs:range practicaecsdi:Ciutat ;
    rdfs:subPropertyOf owl:topObjectProperty .

practicaecsdi:Ubicat_en a owl:ObjectProperty ;
    rdfs:comment "un Centre logistic esta ubicat en una ciutat" ;
    rdfs:domain practicaecsdi:CentreLogistic ;
    rdfs:range practicaecsdi:Direcció ;
    rdfs:subPropertyOf owl:topObjectProperty .

practicaecsdi:Una a owl:ObjectProperty ;
    rdfs:domain practicaecsdi:Transferir ;
    rdfs:range practicaecsdi:Compra ;
    rdfs:subPropertyOf owl:topObjectProperty .

practicaecsdi:Viu2_a a owl:ObjectProperty ;
    rdfs:domain practicaecsdi:Usuari ;
    rdfs:range practicaecsdi:Direcció ;
    rdfs:subPropertyOf owl:topObjectProperty .

practicaecsdi:Viu_a a owl:ObjectProperty ;
    rdfs:comment """1 usuari viu a 1 ciutat\r
1 ciutat hi viuen 1..* usuaris""" ;
    rdfs:domain practicaecsdi:Usuari ;
    rdfs:range practicaecsdi:Ciutat ;
    rdfs:subPropertyOf owl:topObjectProperty .

practicaecsdi:carrer a owl:DatatypeProperty ;
    rdfs:domain practicaecsdi:Direcció ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

practicaecsdi:categoria a owl:DatatypeProperty ;
    rdfs:domain practicaecsdi:Producte ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

<http://www.semanticweb.org/hp/ontologies/2024/4/PracticaECSDI#cobrat?> a owl:DatatypeProperty ;
    rdfs:domain practicaecsdi:Compra ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf owl:topDataProperty .

practicaecsdi:correu a owl:DatatypeProperty ;
    rdfs:domain practicaecsdi:Usuari ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

practicaecsdi:data a owl:DatatypeProperty ;
    rdfs:domain practicaecsdi:Compra,
        practicaecsdi:OfertaTransport,
        practicaecsdi:Recomanacio,
        practicaecsdi:TriarTransportista,
        practicaecsdi:Valoracio ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf owl:topDataProperty .

practicaecsdi:dataEntrega a owl:DatatypeProperty ;
    rdfs:domain practicaecsdi:EnviarLots ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf owl:topDataProperty .

practicaecsdi:dataEnviament a owl:DatatypeProperty ;
    rdfs:domain practicaecsdi:EnviarLots ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf owl:topDataProperty .

practicaecsdi:dataMaximaEntrega a owl:DatatypeProperty ;
    rdfs:domain practicaecsdi:DemanarOfertaTransport ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf owl:topDataProperty .

practicaecsdi:descripcio a owl:DatatypeProperty ;
    rdfs:domain practicaecsdi:CentreLogistic,
        practicaecsdi:EmpresaTransport,
        practicaecsdi:Producte,
        practicaecsdi:Valoracio ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

practicaecsdi:estrelles a owl:DatatypeProperty ;
    rdfs:domain practicaecsdi:Valoracio ;
    rdfs:range xsd:int ;
    rdfs:subPropertyOf owl:topDataProperty .

practicaecsdi:estrellesMitges a owl:DatatypeProperty ;
    rdfs:domain practicaecsdi:Producte ;
    rdfs:range xsd:double ;
    rdfs:subPropertyOf owl:topDataProperty .

practicaecsdi:latitud a owl:DatatypeProperty ;
    rdfs:domain practicaecsdi:Ciutat ;
    rdfs:range xsd:float ;
    rdfs:subPropertyOf owl:topDataProperty .

practicaecsdi:longitud a owl:DatatypeProperty ;
    rdfs:domain practicaecsdi:Ciutat ;
    rdfs:range xsd:float ;
    rdfs:subPropertyOf owl:topDataProperty .

practicaecsdi:nom a owl:DatatypeProperty ;
    rdfs:domain practicaecsdi:Ciutat,
        practicaecsdi:Producte,
        practicaecsdi:Transportista,
        practicaecsdi:Usuari,
        practicaecsdi:Valoracio,
        practicaecsdi:VenedorExtern ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

practicaecsdi:nomEmpresa a owl:DatatypeProperty ;
    rdfs:domain practicaecsdi:EmpresaTransport ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

practicaecsdi:nomUsuari a owl:DatatypeProperty ;
    rdfs:subPropertyOf owl:topDataProperty .

practicaecsdi:numCerques a owl:DatatypeProperty ;
    rdfs:domain practicaecsdi:CercaUsuari ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf owl:topDataProperty .

practicaecsdi:numValoracions a owl:DatatypeProperty ;
    rdfs:domain practicaecsdi:Producte ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf owl:topDataProperty .

practicaecsdi:numero a owl:DatatypeProperty ;
    rdfs:domain practicaecsdi:Direcció ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf owl:topDataProperty .

practicaecsdi:pais a owl:DatatypeProperty ;
    rdfs:domain practicaecsdi:Ciutat ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

practicaecsdi:pes a owl:DatatypeProperty ;
    rdfs:domain practicaecsdi:DemanarOfertaTransport,
        practicaecsdi:TriarTransportista ;
    rdfs:range xsd:float ;
    rdfs:subPropertyOf owl:topDataProperty .

practicaecsdi:pis a owl:DatatypeProperty ;
    rdfs:domain practicaecsdi:Direcció ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

practicaecsdi:preu a owl:DatatypeProperty ;
    rdfs:domain practicaecsdi:OfertaTransport,
        practicaecsdi:Producte ;
    rdfs:range xsd:double ;
    rdfs:subPropertyOf owl:topDataProperty .

practicaecsdi:preuTotal a owl:DatatypeProperty ;
    rdfs:domain practicaecsdi:Compra ;
    rdfs:range xsd:double ;
    rdfs:subPropertyOf owl:topDataProperty .

practicaecsdi:prioritatEntrega a owl:DatatypeProperty ;
    rdfs:comment """Baixa prioritat: no es paga res extra\r
Mitja prioritat: es paga un 5% extra de la compra\r
Alta prioritat: es paga un 10% extra de la compra\r
\r
1: Alta prioritat d'entrega\r
2: Mitjana prioritat d'entrega\r
3: Baixa prioritat d'entrega""" ;
    rdfs:domain practicaecsdi:Compra ;
    rdfs:range xsd:int ;
    rdfs:subPropertyOf owl:topDataProperty .

practicaecsdi:quantitat a owl:DatatypeProperty ;
    rdfs:domain practicaecsdi:Stock ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf owl:topDataProperty .

practicaecsdi:telefon a owl:DatatypeProperty ;
    rdfs:domain practicaecsdi:VenedorExtern ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

practicaecsdi:DemanarDisponibilitat a owl:Class ;
    rdfs:subClassOf practicaecsdi:Accio .

practicaecsdi:IniciarCompra a owl:Class ;
    rdfs:subClassOf practicaecsdi:Accio .

practicaecsdi:MostrarProducte a owl:Class ;
    rdfs:subClassOf practicaecsdi:BuscarProducte .

practicaecsdi:PeticioDevolucio a owl:Class ;
    rdfs:subClassOf practicaecsdi:Accio .

practicaecsdi:ProductePropi a owl:Class ;
    rdfs:subClassOf practicaecsdi:Producte .

practicaecsdi:RegistrarProducteExtern a owl:Class ;
    rdfs:subClassOf practicaecsdi:Accio .

practicaecsdi:Transferir a owl:Class ;
    rdfs:subClassOf practicaecsdi:Accio .

practicaecsdi:ProducteExtern a owl:Class ;
    rdfs:subClassOf practicaecsdi:Producte ;
    owl:disjointWith practicaecsdi:ProductePropi .

practicaecsdi:BuscarProducte a owl:Class ;
    rdfs:subClassOf practicaecsdi:Accio .

practicaecsdi:CercaUsuari a owl:Class .

practicaecsdi:Recomanacio a owl:Class .

practicaecsdi:Stock a owl:Class .

practicaecsdi:TriarTransportista a owl:Class ;
    rdfs:subClassOf practicaecsdi:Accio .

practicaecsdi:VenedorExtern a owl:Class .

practicaecsdi:CompraUsuari a owl:Class .

practicaecsdi:DemanarOfertaTransport a owl:Class ;
    rdfs:subClassOf practicaecsdi:Accio .

practicaecsdi:EnviarLots a owl:Class ;
    rdfs:subClassOf practicaecsdi:Accio .

practicaecsdi:LotProductes a owl:Class .

practicaecsdi:OfertaTransport a owl:Class .

practicaecsdi:Transportista a owl:Class .

practicaecsdi:CentreLogistic a owl:Class .

practicaecsdi:Valoracio a owl:Class .

practicaecsdi:Direcció a owl:Class .

practicaecsdi:EmpresaTransport a owl:Class .

practicaecsdi:Usuari a owl:Class .

practicaecsdi:Accio a owl:Class .

practicaecsdi:Ciutat a owl:Class .

practicaecsdi:Compra a owl:Class .

practicaecsdi:Producte a owl:Class .

